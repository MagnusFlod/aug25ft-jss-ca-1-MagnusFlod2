<!DOCTYPE html><!--This page displays all the memes-->
<html lang="en">

<head>
  <title>Portfolio</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css" />
  <link href="/stylesheets/navbar.css" rel="stylesheet">
</head>

<body class="position-relative" data-bs-spy="scroll">
  <%- include('./partials/navbar.ejs') %>
    <section class="container">
      <form method="POST" action="/memes/search" class="mb-3 mt-4">
        <div class="input-group">
          <input type="text" name="search" class="form-control" placeholder="Search memes by name">
          <button class="btn btn-outline-secondary" type="submit">Search</button>
        </div>
      </form>
      <table class="table" id="table"><!--Table start-->
        <thead>
          <tr>
            <!--Main columns-->
            <th scope="col">ID</th>
            <th scope="col">Size</th>
            <th scope="col">Image</th>
            <th scope="col">Options</th>
          </tr>
        </thead>
        <tbody>
          <!--If the particular memes are in the array, a for-loop iterates through every meme and displays the meme-details-->
          <% if (Array.isArray(memes)) { %>
          <% memes.forEach(function(meme) { %>
            <tr class="<%= viewedMemes.includes(meme.id) ? 'table-success' : '' %>"><!--When meme-details are viewed, the meme row changes color to green-->
              <!--ID-->
            <th scope="row">
              <%= meme.id %>
            </th>

            <td>
              <%= meme.name %>
            </td>
            <!--Size-->
            <td>
              <%= meme.width %> x <%= meme.height %>
            </td>
            <!--Image-->
            <td>
              <img src="<%= meme.url %>" width="100" alt="<%= meme.name %>">
            </td>
            <!--Options-->
            <td>
              <% if (isLoggedIn) { %>
              <button class="details-btn btn btn-primary" data-id="<%= meme.id %>">Details</button><% } %>
            </td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
      </table>
    </section>
    <%- include('./partials/scripts.ejs') %>
</body>

</html>